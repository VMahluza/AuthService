@host = http://localhost:5102
@token = YOUR_JWT_TOKEN_HERE
@groupId = YOUR_GROUP_ID_HERE
@userId = YOUR_USER_ID_HERE

### Remove a user from a group (Admin only)
DELETE {{host}}/api/groups/{{groupId}}/users/{{userId}}
Authorization: Bearer {{token}}

###

# Example with actual GUIDs
DELETE {{host}}/api/groups/223e4567-e89b-12d3-a456-426614174000/users/123e4567-e89b-12d3-a456-426614174000
Authorization: Bearer {{token}}
