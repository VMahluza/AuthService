@host = http://localhost:5102
@token = YOUR_JWT_TOKEN_HERE
@roleId = YOUR_ROLE_ID_HERE
@userId = YOUR_USER_ID_HERE

### Remove a role from a user (Admin only)
DELETE {{host}}/api/roles/{{roleId}}/users/{{userId}}
Authorization: Bearer {{token}}

###

# Example with actual GUIDs
DELETE {{host}}/api/roles/123e4567-e89b-12d3-a456-426614174001/users/123e4567-e89b-12d3-a456-426614174000
Authorization: Bearer {{token}}
