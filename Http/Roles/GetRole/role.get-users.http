@host = http://localhost:5102
@token = YOUR_JWT_TOKEN_HERE
@roleId = YOUR_ROLE_ID_HERE

### Get all users assigned to a specific role
GET {{host}}/api/roles/{{roleId}}/users
Authorization: Bearer {{token}}

###

# Example with actual GUID
GET {{host}}/api/roles/123e4567-e89b-12d3-a456-426614174001/users
Authorization: Bearer {{token}}
